<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Content/Graphics/GameLogo/JumpScapeLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MonoGame looks for these two embedded resources to set the window icon. -->
    <EmbeddedResource Include="Content/Graphics/GameLogo/JumpScapeLogo.ico" LogicalName="Icon.ico" />
    <EmbeddedResource Include="Content/Graphics/GameLogo/JumpScapeLogo.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Level files are read at runtime, so ship them next to the executable. -->
    <None Update="Levels/Level*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
